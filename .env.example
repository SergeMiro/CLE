# --- runtime ---------------------------------------------------------------
NODE_ENV=development
# mock: no external calls (Telegram/TON/AI are simulated). live: real providers.
APP_MODE=mock
LOG_LEVEL=info

# --- infrastructure --------------------------------------------------------
DATABASE_URL=postgresql://cle:cle@localhost:5432/cle?schema=public
REDIS_URL=redis://localhost:6380

# --- services --------------------------------------------------------------
API_PORT=4101
MINIAPP_PORT=4100
API_URL=http://localhost:4101
MINI_APP_URL=http://localhost:4100

# --- telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=
# Short name of a named Mini App (BotFather /newapp). Leave empty for a Main Mini App.
TELEGRAM_MINI_APP_NAME=
# Secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# APP_MODE=mock only: shared file for the simulated Telegram world.
MOCK_TELEGRAM_STATE_FILE=.cle/mock-telegram.json

# --- TON -------------------------------------------------------------------
TON_NETWORK=testnet
TON_RPC_URL=
TON_API_KEY=
TON_TREASURY_ADDRESS=
TON_TREASURY_MNEMONIC=

# --- security --------------------------------------------------------------
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
PLATFORM_ADMIN_TELEGRAM_IDS=
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=60

# --- platform policy (bootstrap defaults, versioned in the database) --------
PLATFORM_FEE_BPS=1000
MAX_CREATOR_SHARE_BPS=1000
DEFAULT_GROWTH_BPS=3500
DEFAULT_LOYALTY_BPS=4000
DEFAULT_REFERRAL_BPS=1500
DEFAULT_LEARNING_BPS=1000
MIN_WITHDRAWAL_NANOTON=100000000
MAX_QUIZZES_PER_DAY=3
REFERRAL_QUALIFICATION_DAYS=30
NEW_MEMBER_HOLD_DAYS=7
REJOIN_COOLDOWN_DAYS=7

# --- AI --------------------------------------------------------------------
# mock | openrouter | gemini | anthropic | openai-compatible
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_QUALITY_THRESHOLD=70
